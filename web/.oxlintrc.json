{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "unicorn", "oxc", "vitest"],
  "categories": { "correctness": "error", "suspicious": "error", "perf": "error" },
  "env": { "browser": true },
  "ignorePatterns": ["node_modules", "dist", "src/shared/api/schema.gen.ts"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    // Frames of a stream are read one after another; there is nothing to run in parallel.
    "eslint/no-await-in-loop": "off",
    // JSON from the API is asserted to the contract's types once, at the boundary (src/shared/api).
    "typescript/no-unsafe-type-assertion": "off",
    "react/no-danger": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "import/no-cycle": "error",
    "import/no-unassigned-import": "off"
  }
}
