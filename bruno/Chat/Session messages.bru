meta {
  name: Session messages
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/chat/sessions/{{threadId}}/messages
  body: none
  auth: inherit
}

params:query {
  limit: 50
  ~before:
}

assert {
  res.status: eq 200
  res.body: isArray
}

docs {
  The transcript of one thread. A thread that is not the caller's is a 404, the same as an unknown one.

  `limit` returns only the last that many messages (1 to 500; leave it out for the whole transcript). Each message carries its `index`, its place in the whole
  transcript: pass the smallest one of a page as `before` to read the page that precedes it. The web page reads the last 50 and offers "Load earlier messages".
}
