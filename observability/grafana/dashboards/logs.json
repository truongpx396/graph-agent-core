        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values(compose_service)",
        "query": {
          "type": 1,
          "label": "compose_service",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": ["api", "agent-worker", "ingest-worker", "mcp-gateway", "telegram-bot", "ml-service", "caddy-gateway", "caddy", "authlimit"],
