  "panels": [
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors and warnings by service",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "legendFormat": "{{compose_service}}",
          "expr": "sum by (compose_service) (count_over_time({compose_service=~\"$service\", level=~\"error|warning|critical|fatal\"} |= `$request_id` |= `$thread_id` |= `$search` [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Logs",
      "description": "Fill a box above to follow one request or conversation. In Explore's Table view, the request_id column also links to all of that request's lines.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{compose_service=~\"$service\", level=~\"$level\"} |= `$request_id` |= `$thread_id` |= `$search`",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 22,
        "w": 24,
        "x": 0,
        "y": 6
      }
    }
  ]
}
