# Copy to terraform.tfvars (gitignored) and fill in, or export TF_VAR_* / DIGITALOCEAN_TOKEN instead.

do_token = "" # https://cloud.digitalocean.com/account/api/tokens — scope: read+write

ssh_key_fingerprints = [
  # `doctl compute ssh-key list`, or upload one first:
  # doctl compute ssh-key create my-key --public-key-file ~/.ssh/id_ed25519.pub
  "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99",
]

# Your own IP(s) only — curl -s ifconfig.me. SSH is the only inbound port.
admin_ip_cidrs = ["203.0.113.4/32"]

# The key you will SSH with as the deploy user (your own is fine here).
deploy_ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

region = "nyc3"

# 16 GB is the floor for the whole dev stack on one box; billed hourly, so `terraform destroy` when you are done.
# droplet_size = "s-8vcpu-16gb"
