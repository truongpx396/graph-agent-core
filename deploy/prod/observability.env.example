# Template for /opt/agent-core-observability/.env on the SEPARATE observability droplet (deploy/terraform's digitalocean_droplet.observability): copy it there and fill in real values
# ONCE, by hand, over SSH. Same posture as deploy/prod/prod.env.example: the operator sets .env, CI never touches secrets. Every variable deploy/prod/observability.yml reads is listed here
# (tests/core/test_env_examples_match_compose.py).

# --- Grafana admin login ---
# This instance is reachable from the internet through Caddy, so it needs a real password (the dev stack's admin/admin and anonymous viewer are for a laptop). Generate: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=

# --- Where alerts go: REQUIRED ---
# deploy/prod/observability.yml refuses to start without it, because a stack that cannot reach anyone looks healthy and delivers nothing (spec 008 A7). A Slack incoming-webhook URL
# (https://api.slack.com/messaging/webhooks); Alertmanager reads it from a file the compose file writes at startup, so it never appears in a committed config. To page someone instead,
# add a receiver in observability/alertmanager/alertmanager.prod.yml.
ALERTMANAGER_SLACK_WEBHOOK_URL=

# --- Reverse proxy and TLS (deploy/prod/caddy/Caddyfile.observability) ---
# Empty serves plain HTTP on this droplet's reserved IP instead of a real domain and certificate. If set, also set deploy/terraform's obs_domain_name to match (informational there; this is
# what Caddy acts on).
OBS_DOMAIN_NAME=
