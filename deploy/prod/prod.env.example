# Template for /opt/graph-agent-core/.env on the app droplet: copy it there and fill in real values ONCE, by hand, over SSH (deploy/README.md, "One-time setup").
# Never committed with real values, and never written by .github/workflows/deploy.yml, which ships code and config, not secrets (see deploy/prod/docker-compose.yml's header).
#
# The development counterpart is the repository's .env.example, in the same order. A name in both means the same thing, and each example lists every variable its compose
# files read (tests/core/test_env_examples_match_compose.py). A commented line shows the default used while it stays commented.

# --- Container images (CI builds and publishes them to GHCR; .github/workflows/deploy.yml passes IMAGE_TAG, which release.sh records in .image-tag, so it is not stored here) ---
# Lowercase, and they must match your GitHub org or user and repo.
APP_IMAGE=ghcr.io/your-gh-username/graph-agent-core
ML_IMAGE=ghcr.io/your-gh-username/graph-agent-core-ml-service
AUTHLIMIT_IMAGE=ghcr.io/your-gh-username/graph-agent-core-authlimit

# --- LLM access (everything goes through the LiteLLM proxy) ---
# Generate: openssl rand -hex 24. Callers send it as their OPENAI_API_KEY; the API and workers get it through deploy/prod/app.yml's *app-env anchor.
LITELLM_MASTER_KEY=
# The key the APP sends: scoped and budget-capped, so the app never holds gateway admin credentials and the gateway can stop runaway spend even if every app-side ceiling fails.
# Leave it empty on the first deploy (LiteLLM has to be up to mint it), then, with the master key in the environment:
#   python -m scripts.tools.litellm_key create --max-budget <usd per 30 days>
# and paste the key it prints here. Until you do, the app falls back to the master key.
LITELLM_APP_KEY=
LITELLM_UI_USERNAME=admin
# Generate: openssl rand -hex 16
LITELLM_UI_PASSWORD=

# The upstream model (deploy/prod/litellm-config.yaml): any OpenAI-compatible endpoint. The example targets OpenAI; swap in Anthropic's OpenAI-compatible endpoint, a hosted vLLM or Ollama, etc.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=openai/gpt-4o-mini
LLM_EMBED_MODEL=openai/text-embedding-3-small
# Optional middle tier (the `chat-medium` alias; `chat` is the easy tier, `chat-strong` the strong one). Unset = the chat model above. Nothing selects it automatically: a delegated specialist
# names it in its AGENT.md `model:`, or you point CHAT_MODEL at it. To attach Gemini through Google's OpenAI-compatibility endpoint (beta, per Google) set all three, state the price in
# deploy/prod/litellm-config.yaml (LiteLLM does not know an `openai/<gemini id>`, and UNPRICED_MODEL_POLICY=block refuses an unpriced one), restart the proxy, then run
# `make probe-tools ARGS="--alias chat-medium"`. Use a different key per tier to cap each in Google's console.
# LLM_MEDIUM_CHAT_MODEL=openai/<a Gemini flash-class model id>
# LLM_MEDIUM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MEDIUM_API_KEY=
# Optional stronger model the router may escalate a turn to (the `chat-strong` alias; specs/014). Unset = the chat model, so nothing changes. To attach one, set all three (any
# OpenAI-compatible endpoint with native tool calls), restart the proxy, then set STRONG_CHAT_MODEL=chat-strong and ROUTER_MODE=shadow (then on) for the app. If LiteLLM does not know
# the model's price, state it in deploy/prod/litellm-config.yaml (model_info) before using UNPRICED_MODEL_POLICY=block.
# LLM_STRONG_CHAT_MODEL=
# LLM_STRONG_API_BASE=
# LLM_STRONG_API_KEY=

# --- Postgres (shared by LiteLLM, the checkpointer and appdata; deploy/prod/infra.yml says why the role stays "langfuse") ---
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Object storage: DigitalOcean Spaces by default (S3-compatible; deploy/prod/docker-compose.yml's header says why no MinIO container runs here) ---
# Create a Space and an access key at https://cloud.digitalocean.com/spaces
MINIO_ENDPOINT=nyc3.digitaloceanspaces.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=graph-agent-core-uploads
MINIO_SECURE=true

# --- The front door: three public names, REQUIRED (deploy/prod/caddy/Caddyfile, deploy/prod/gateway.yml) ---
# Identity needs an https issuer, so there is no plain-HTTP fallback and no default: compose refuses to start without them. Point an A/AAAA record for each at the droplet's reserved IP
# first (deploy/README.md, "Point DNS at them"); Caddy then gets a Let's Encrypt certificate for each on first use.
#   API_DOMAIN   the chat API and the web page; the audience of every token
#   AUTH_DOMAIN  Casdoor; the issuer of every token, where people sign in
#   MCP_DOMAIN   the MCP gateway's read-only tools
API_DOMAIN=api.your-domain.example.com
AUTH_DOMAIN=auth.your-domain.example.com
MCP_DOMAIN=mcp.your-domain.example.com

# --- Casdoor, the authorization server (deploy/prod/gateway.yml, with its own Postgres): both required ---
# Generate each: openssl rand -hex 24. The admin password is the `built-in` organization's `admin`, whose login is on AUTH_DOMAIN: treat it as the keys to every tenant. The first sign-in,
# tenants and users are created once, by hand (deploy/README.md, "Create the tenants and sign-in clients").
CASDOOR_DB_PASSWORD=
CASDOOR_ADMIN_PASSWORD=

# --- authlimit and the MCP gateway (deploy/prod/gateway.yml, app.yml) ---
# authlimit's signing keys: a host directory OUTSIDE the repo and the image, mode 700, owned by uid 65532, made once (deploy/README.md). The default is where the runbook makes it.
# AUTHLIMIT_KEYS_DIR=/opt/graph-agent-core/authlimit-keys
# `enforce` (the default) refuses over-limit requests with a 429; `observe` serves them and counts what it would have refused, for sizing a new limit.
# AUTHLIMIT_LIMIT_MODE=enforce
# The MCP gateway's ops tools read a Prometheus; the observability droplet's is not reachable from here by default, so point this at one that is.
# MCP_GATEWAY_PROMETHEUS_URL=
# MCP_GATEWAY_OPS_TENANTS=ops-team

# --- Who is calling the API (specs/018 T069, pattern 98) ---
# Production runs in identity mode: the API trusts only the signed identity the front door adds to a request it verified. deploy/prod/app.yml sets AUTH_MODE=identity, AUTHLIMIT_KEYS_URL and
# the web page's WEB_AUTH_ISSUER and WEB_AUTH_AUDIENCE itself, derived from AUTH_DOMAIN and API_DOMAIN above so they cannot disagree with what authlimit and Casdoor start with: there is
# nothing to set here. NEVER set AUTH_MODE=headers on a deployment a stranger can reach (any client could claim any tenant); the alert ApiHeaderAuthMode fires if it is left on.

# --- API protection (the built-in web page is served from API_DOMAIN) ---
# A real deployment narrows CORS from the dev default (`*`) to its actual frontend origin(s), comma-separated.
CORS_ALLOWED_ORIGINS=https://api.your-domain.example.com

# --- Telegram (opt-in: `docker compose --project-directory . -f deploy/prod/docker-compose.yml --profile telegram up -d`) ---
# The token is its only required setting. `poll` (the default) needs no public address; `webhook` is served by Caddy at API_DOMAIN/telegram/webhook, so set the webhook URL to
# https://<API_DOMAIN>/telegram/webhook and a secret of 32 to 256 of A-Z a-z 0-9 _ -. Each Telegram user is a person `telegram-<id>` of TELEGRAM_TENANT, signed in with a password derived
# from TELEGRAM_PERSON_SECRET (at least 32 characters; required); or set TELEGRAM_LINKING=true and a Fernet TELEGRAM_LINK_KEY so people link their own account with /login. The agent worker
# must serve the bot's domain.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_MODE=poll
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_PERSON_SECRET=
# TELEGRAM_TENANT=ecorp
# TELEGRAM_AGENT_DOMAIN=ecorp
# TELEGRAM_LINKING=false
# TELEGRAM_LINK_KEY=

# --- Team-channel notifications (optional: empty falls back to a local log sink) ---
SLACK_WEBHOOK_URL=

# --- Tools (optional: empty = the tool is absent) ---
# The sandbox server is never run here (it mounts the Docker socket). The crawler is opt-in: CRAWLER_ENABLED=true makes deploy/prod/compose.sh add the crawler overlay
# (deploy/prod/tools.yml, which points the app roles at it itself), but only after `deploy/prod/crawler-firewall.sh install` (deploy/README.md, "The crawler's network").
# CRAWL4AI_API_TOKEN is then required: any long random value. Set CRAWL4AI_SERVER_URL only to reach a crawler you run elsewhere.
# CRAWLER_ENABLED=false
CRAWL4AI_SERVER_URL=
CRAWL4AI_API_TOKEN=
# Web search: a key from https://serper.dev/api-keys. Empty leaves `web_search` declared but answering that search is not set up. Each search spends one credit, and every call waits for a
# human approval.
SERPER_API_KEY=
# Results one search hands the model (1-10; also what Serper is asked for, and 10 is its default page).
# WEB_SEARCH_MAX_RESULTS=5
OPENSANDBOX_MCP_DOMAIN=
OPENSANDBOX_API_KEY=

# --- Langfuse tracing (optional: empty = no tracing; none runs here, so point it at one you run) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Observability droplet (deploy/prod/collectors.yml's otel-collector-agent and promtail) ---
# The separate, smaller droplet deploy/terraform provisions (digitalocean_droplet.observability). Get the address from `terraform output observability_private_ipv4` after `terraform apply`: a
# private VPC IP, never reachable from the internet, so these are safe unencrypted. Leaving either empty just means this droplet's metrics and logs go nowhere; the app is unaffected.
OBS_COLLECTOR_ENDPOINT=http://<observability_private_ipv4>:4318
LOKI_PUSH_HOST=<observability_private_ipv4>:3100
# Continuous profiling (specs/022): the observability droplet's Pyroscope, same private address. LEAVE EMPTY until the observability stack is up and 4040 is open on it (terraform firewall and
# ufw); empty means no profiling and nothing else changes. Not tried on a droplet yet.
PYROSCOPE_SERVER_ADDRESS=

# The ops agent's fetch_metrics_summary reads a Prometheus. The observability droplet's is not reachable from the app droplet by default (its firewall opens Grafana,
# OTLP, Loki and Pyroscope only), so left as it is the tool answers that no metric could be read. Point it at one this droplet can reach.
# PROMETHEUS_URL=http://localhost:9090

# --- Answer quality ---
# An answer that opens by saying the pre-fetched documents lack it is asked once more without them, so the model can use a tool; the first answer returns if
# it uses none (docs/GRAPH_PATTERNS.md pattern 105). One extra model call on those turns. "false" turns it off.
# CONTEXT_GAP_REASK_ENABLED=true

# --- Spend and time ceilings (app/core/config.py says what each one means) ---
# Non-zero here, unlike the local Ollama stack, because LLM_API_BASE is a real paid provider.
MAX_COST_USD_PER_TURN=0.50
# Cumulative tokens one turn may use before its next tool call is refused. Raise it, not lower it, if a multi-step answer comes back unfinished.
# MAX_TOKENS_PER_TURN=40000
MAX_COST_USD_PER_TENANT_PER_DAY=20.0
# Starter values for the three optional limits (0 = off, which is what an unset line means). 20/day x 30 days is a $600 ceiling, so a $400 month turns a runaway tenant into a refusal well
# before the bill does; a $5 personal day stops one account from using a quarter of the tenant's day. Tune all three to your pricing and users.
MAX_COST_USD_PER_TENANT_PER_MONTH=400.0
MAX_COST_USD_PER_PRINCIPAL_PER_DAY=5.0
MAX_COST_USD_PER_PRINCIPAL_PER_MONTH=100.0
# Every ceiling multiplies tokens by a price LiteLLM supplies. A model it cannot price (a self-hosted vLLM, a fine-tune) would make them all read $0, so refuse to serve it until `model_info`
# costs are set in deploy/prod/litellm-config.yaml.
UNPRICED_MODEL_POLICY=block
# The longest the chat client waits for the gateway to send ANYTHING (between stream chunks, not the answer's length), in seconds. 30 suits the hosted model above and leaves room for one retry
# inside the 60 s turn; raise it for a reasoning model that thinks silently for longer, or blank it to follow the turn's limit. It may not exceed REQUEST_TIMEOUT_SECONDS (60 here).
LLM_READ_TIMEOUT_SECONDS=30

# --- Workers and the ML service ---
# The domains the agent worker serves: comma-separated names, or `all` (ecorp, support, ops, sales). One process serves them all, under AGENT_WORKER_MAX_CONCURRENCY. Ecorp only by default;
# the other three are demo domains.
AGENT_WORKER_DOMAINS=ecorp
# The ML service (services/ml-service: the reranker, the prompt-injection classifier and embeddings): the same three knobs, with the same defaults, as the development .env.example.
# Measure memory before enabling another model: it idles near 0.8 GiB with bge-small against the container's 2g limit.
# ML_MODELS_ENABLED=                  # comma list of services/ml-service/models.toml names to load; empty = the entries marked enabled
# ML_EMBED_MAX_ITEMS=256              # /v1/embeddings: more inputs than this is a 400, never truncated
# ML_EMBED_MAX_CHARS=8000             # /v1/embeddings: a longer input is a 400
